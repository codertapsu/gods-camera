      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lật hình như gương"
          }
        }
      }
    },
    "Move God's Camera to the Applications folder first. macOS only installs camera extensions from there.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chuyển God's Camera vào thư mục Ứng dụng trước. macOS chỉ cài phần mở rộng camera từ đó."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên"
          }
        }
      }
    },
    "No camera was found.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy camera nào."
          }
        }
      }
    },
    "No file chosen": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chọn tệp"
          }
        }
      }
    },
    "NO PICTURE": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KHÔNG CÓ HÌNH"
          }
        }
