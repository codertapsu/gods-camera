      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GHI %lld giây"
          }
        }
      }
    },
    "Receive scans from my phone or tablet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận bản quét từ điện thoại hoặc máy tính bảng"
          }
        }
      }
    },
    "Record a few seconds of yourself, then play them as your camera picture.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi vài giây hình của bạn, rồi phát lại làm hình camera."
          }
        }
      }
    },
    "Record a loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một đoạn lặp"
          }
        }
      }
    },
    "Remove the camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ camera"
          }
        }
      }
    },
    "Repeat": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách lặp"
          }
        }
      }
    },
    "Restart the Mac to finish.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại máy Mac để hoàn tất."
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu"
          }
        }
      }
    },
    "Save a diagnostics report…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu báo cáo chẩn đoán…"
          }
        }
      }
    },
    "Saved faces are encrypted and stay on this Mac.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khuôn mặt đã lưu được mã hoá và chỉ nằm trên máy Mac này."
          }
        }
      }
    },
    "Saved faces could not be opened.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được các khuôn mặt đã lưu."
          }
        }
      }
    },
    "Saved faces, their encryption key, saved loops, scanned documents and the list of blocked apps are removed from this Mac. This cannot be undone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khuôn mặt đã lưu, khoá mã hoá của chúng, các vòng lặp đã lưu, tài liệu đã quét và danh sách ứng dụng bị chặn sẽ bị xoá khỏi máy Mac này. Không thể hoàn tác."
          }
        }
      }
    },
    "Saved loops": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn lặp đã lưu"
          }
        }
      }
    },
    "Scanner": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy quét"
          }
        }
      }
    },
    "Sharper": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắc nét hơn"
          }
        }
