    },
    "Getting the models ready. The first time takes a little longer.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chuẩn bị các mô hình. Lần đầu sẽ lâu hơn một chút."
          }
        }
      }
    },
