{
  "sourceLanguage": "en",
  "strings": {
    "%.0f fps · render %.1f ms": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f khung hình/giây · dựng hình %.1f ms"
          }
        }
      }
    },
    "%.1f s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f giây"
          }
        }
      }
    },
    "%@ · %.1f s, loops %.1f s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %.1f giây, lặp %.1f giây"
          }
        }
      }
    },
    "%lld app(s) reading · %.1f ms from capture to camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ứng dụng đang dùng · %.1f ms từ lúc quay đến camera"
          }
        }
      }
    },
    "A blocked app is reading the camera, so no picture is sent to any app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng bị chặn đang dùng camera, nên không gửi hình ảnh đến ứng dụng nào."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép"
          }
        }
      }
    },
    "Allow camera access": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép dùng camera"
          }
        }
      }
    },
    "An older version is installed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cài phiên bản cũ hơn."
          }
        }
      }
    },
    "Back and forth": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tới rồi lui"
          }
        }
      }
    },
    "Back to live": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trở về trực tiếp"
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn"
          }
        }
      }
    },
    "Blocked apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng bị chặn"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra lại"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn…"
          }
        }
      }
    },
    "Colour bars with a moving block, for checking the camera in other apps.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dải màu với một khối di chuyển, dùng để kiểm tra camera trong ứng dụng khác."
          }
        }
      }
    },
    "Control-Option-Command-L": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-Command-L"
          }
        }
      }
    },
    "Control-Option-Command-R": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-Command-R"
          }
        }
      }
    },
    "Delete this loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá đoạn lặp này"
          }
        }
      }
    },
    "Go back to live when I start to speak": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại trực tiếp khi tôi bắt đầu nói"
          }
        }
      }
    },
    "God's Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "God's Camera"
          }
        }
      }
    },
    "God's Camera needs your permission to use the camera.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "God's Camera cần bạn cho phép dùng camera."
          }
        }
      }
    },
    "Image": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh"
          }
        }
      }
    },
