    },
    "Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huỷ"
          }
        }
      }
