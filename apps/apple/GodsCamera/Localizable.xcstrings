      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy khuôn mặt nào trong hình."
          }
        }
      }
    },
    "No face was found in that picture.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy khuôn mặt nào trong hình đó."
          }
        }
      }
    },
    "No file chosen": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chọn tệp"
          }
        }
      }
    },
    "NO PICTURE": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KHÔNG CÓ HÌNH"
          }
        }
      }
    },
    "No picture": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có hình"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sau"
          }
        }
      }
