    "Open System Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt hệ thống"
          }
        }
      }
    },
    "Open the document": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tài liệu"
          }
        }
      }
    },
    "Other apps cannot see God's Camera until it is installed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng khác chưa thấy God's Camera cho đến khi bạn cài đặt."
          }
        }
      }
    },
    "People in a call will see a face that is not the one in front of the camera. Please use this fairly.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người trong cuộc gọi sẽ thấy một khuôn mặt khác với khuôn mặt trước camera. Hãy dùng tính năng này một cách đàng hoàng."
          }
        }
      }
    },
    "Picture": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh"
          }
        }
      }
    },
    "Play the loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát đoạn lặp"
          }
        }
      }
    },
    "Quality": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng"
          }
        }
      }
    },
    "Quit God's Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát God's Camera"
          }
        }
      }
    },
    "Reading %lld %…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đọc %lld %…"
          }
        }
      }
    },
