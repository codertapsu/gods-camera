    "Check again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra lại"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn…"
          }
        }
      }
    },
    "Colour bars with a moving block, for checking the camera in other apps.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dải màu với một khối di chuyển, dùng để kiểm tra camera trong ứng dụng khác."
          }
        }
      }
    },
    "Connect the device with a USB cable, run tools/connect-android.sh, and enter this token in the app on the device.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nối thiết bị bằng cáp USB, chạy tools/connect-android.sh, rồi nhập mã này vào ứng dụng trên thiết bị."
          }
        }
      }
    },
    "Control-Option-Command-L": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-Command-L"
          }
        }
      }
    },
    "Control-Option-Command-R": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-Command-R"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép"
          }
        }
      }
    },
    "Copy the text": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép văn bản"
          }
        }
      }
    },
    "Could not be read": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được"
          }
        }
      }
    },
    "Delete all my data…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá toàn bộ dữ liệu của tôi…"
          }
        }
      }
    },
