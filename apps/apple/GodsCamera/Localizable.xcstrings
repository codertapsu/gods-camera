{
  "sourceLanguage": "en",
  "strings": {
    "%.0f fps · render %.1f ms": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f khung hình/giây · dựng hình %.1f ms"
          }
        }
      }
    },
    "%.1f s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f giây"
          }
        }
      }
    },
    "%@ · %.1f s, loops %.1f s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %.1f giây, lặp %.1f giây"
          }
        }
      }
    },
    "%lld app(s) reading · %.1f ms from capture to camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ứng dụng đang dùng · %.1f ms từ lúc quay đến camera"
          }
        }
      }
    },
    "A blocked app is reading the camera, so no picture is sent to any app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng bị chặn đang dùng camera, nên không gửi hình ảnh đến ứng dụng nào."
          }
        }
      }
    },
    "A model file is not installed: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cài đặt một tệp mô hình: %@"
          }
        }
      }
    },
    "Add a face first, then turn the swap on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm một khuôn mặt trước, rồi bật tính năng thay mặt."
          }
        }
      }
    },
    "Add a face…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khuôn mặt…"
          }
        }
      }
    },
    "Add this face": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khuôn mặt này"
          }
        }
      }
    },
    "AI FACE": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MẶT AI"
          }
        }
      }
    },
    "AI-generated face": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khuôn mặt do AI tạo"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép"
          }
        }
      }
    },
    "Allow camera access": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép dùng camera"
          }
        }
      }
    },
    "An older version is installed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cài phiên bản cũ hơn."
          }
        }
      }
    },
    "An “AI” badge is drawn on your picture. You can turn it off; consider telling people instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhãn “AI” được vẽ lên hình của bạn. Bạn có thể tắt nó; khi đó hãy cân nhắc nói cho mọi người biết."
          }
        }
      }
    },
    "Back and forth": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tới rồi lui"
          }
        }
      }
    },
    "Back to live": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trở về trực tiếp"
          }
        }
      }
    },
    "Before you swap your face": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bạn thay khuôn mặt"
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn"
          }
        }
      }
    },
    "Blocked apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng bị chặn"
          }
        }
