      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt camera"
          }
        }
      }
    },
    "Installed. Choose “God's Camera” in your meeting app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cài đặt. Hãy chọn “God's Camera” trong ứng dụng họp của bạn."
          }
        }
      }
    },
    "LIVE": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRỰC TIẾP"
          }
        }
      }
    },
    "Live": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trực tiếp"
          }
        }
      }
    },
    "Loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
