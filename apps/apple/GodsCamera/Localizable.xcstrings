      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt hệ thống"
          }
        }
      }
    },
    "Other apps cannot see God's Camera until it is installed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng khác chưa thấy God's Camera cho đến khi bạn cài đặt."
          }
        }
      }
    },
    "Picture": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh"
          }
        }
      }
    },
    "Play the loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát đoạn lặp"
          }
        }
      }
    },
    "Quit God's Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát God's Camera"
          }
        }
      }
    },
    "REC %lld s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GHI %lld giây"
          }
        }
      }
    },
    "Record a few seconds of yourself, then play them as your camera picture.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi vài giây hình của bạn, rồi phát lại làm hình camera."
          }
        }
      }
    },
    "Record a loop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một đoạn lặp"
          }
        }
      }
    },
    "Remove the camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ camera"
          }
        }
      }
    },
    "Repeat": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách lặp"
          }
        }
      }
    },
    "Restart the Mac to finish.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại máy Mac để hoàn tất."
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu"
          }
        }
      }
    },
    "Save a diagnostics report…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu báo cáo chẩn đoán…"
          }
        }
      }
    },
    "Saved loops": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn lặp đã lưu"
          }
        }
      }
    },
    "Show a LOOP badge to others": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện nhãn LOOP cho người khác thấy"
          }
        }
      }
    },
    "Show God's Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở God's Camera"
          }
        }
      }
    },
    "Source": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn"
          }
        }
      }
    },
    "Start to end": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ đầu đến cuối"
          }
        }
      }
    },
    "Stop recording": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng ghi"
          }
        }
      }
    },
    "Test pattern": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình thử"
          }
        }
      }
    },
    "That file could not be opened.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được tệp đó."
          }
        }
      }
    },
    "That loop could not be opened.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được đoạn lặp đó."
          }
        }
      }
    },
    "The app gets no picture from now on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ giờ ứng dụng này sẽ không nhận được hình ảnh."
          }
        }
      }
    },
    "The camera is installed, but macOS has not started it. Restart the Mac to finish.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera đã được cài đặt nhưng macOS chưa khởi động nó. Hãy khởi động lại máy Mac để hoàn tất."
          }
        }
      }
    },
    "The loop could not be saved.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được đoạn lặp."
          }
        }
      }
    },
    "The room looks brighter or darker than in this loop.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng đang sáng hơn hoặc tối hơn so với đoạn lặp này."
          }
        }
      }
    },
    "This Mac's graphics could not be started, so the camera cannot run.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khởi động được phần đồ hoạ của máy Mac này nên camera không chạy được."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại"
          }
        }
      }
    },
    "Update the camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật camera"
          }
        }
      }
    },
    "Uses the microphone only while a loop plays. Nothing is recorded.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng micrô trong lúc phát vòng lặp. Không ghi âm gì cả."
          }
        }
      }
    },
    "Video": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video"
          }
        }
      }
    },
    "Virtual camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera ảo"
          }
        }
      }
    },
    "Waiting for your approval in System Settings › General › Login Items & Extensions › Camera Extensions.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn cho phép trong Cài đặt hệ thống › Cài đặt chung › Mục đăng nhập & Phần mở rộng › Phần mở rộng camera."
          }
        }
      }
    },
    "Without the microphone, God's Camera cannot tell when you start to speak.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có micrô, God's Camera không thể biết khi nào bạn bắt đầu nói."
          }
        }
      }
    }
  },
  "version": "1.0"
}