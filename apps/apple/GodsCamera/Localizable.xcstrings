      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại trực tiếp khi tôi bắt đầu nói"
          }
        }
      }
    },
    "God's Camera": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "God's Camera"
          }
        }
      }
    },
    "God's Camera could not be opened on %@. Install it there first.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được God's Camera trên %@. Hãy cài ứng dụng lên thiết bị đó trước."
          }
        }
      }
    },
    "God's Camera needs your permission to use the camera.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "God's Camera cần bạn cho phép dùng camera."
          }
        }
