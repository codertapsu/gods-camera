        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt"
          }
        }
      }
    },
    "Sharper": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắc nét hơn"
          }
